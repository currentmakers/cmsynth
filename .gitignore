# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# STM32CubeIDE build output
Debug/
Release/

# CMSIS-DSP prebuilt library is needed to link the STM32 examples
!examples/*/Middlewares/Third_Party/ARM_CMSIS/CMSIS/DSP/Lib/GCC/*.a

# Pico SDK build output
build/
build_*/

# CubeIDE per-user language settings (CubeIDE rewrites them)
**/.settings/language.settings.xml

# CubeIDE workspace metadata
.metadata/
